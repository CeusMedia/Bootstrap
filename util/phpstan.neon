includes:
	- ../vendor/phpstan/phpstan-strict-rules/rules.neon
	- phpstan-baseline.neon

parameters:
	phpVersion: 80300
	# level 9 equals former "max" of PHPStan 1; level 10 (now "max") additionally checks implicit mixed
	level: 9
	paths:
		- ../src
		- ../test
		- ../demo
	ignoreErrors:
			-
				identifier: missingType.iterableValue
